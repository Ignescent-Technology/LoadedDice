{
    "name": "ignescent/loaded-dice",
    "description": "Utilities for deterministic randomness.",
    "keywords": [
        "random",
        "randomizer",
        "deterministic",
        "bandit",
        "multi-armed-bandit",
        "distributions",
        "rendezvous-hashing",
        "hrw",
        "laravel"
    ],
    "homepage": "https://github.com/ignescent/loaded-dice",
    "support": {
        "issues": "https://github.com/ignescent/loaded-dice/issues",
        "source": "https://github.com/ignescent/loaded-dice"
    },
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ignescent\\LoadedDice\\": "src/",
            "Ignescent\\LoadedDice\\Laravel\\": "laravel/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ignescent\\LoadedDice\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Michael Cordingley"
        }
    ],
    "require-dev": {
        "illuminate/support": "^13.43",
        "phpunit/phpunit": "^13.4"
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        }
    },
    "extra": {
        "laravel": {
            "aliases": {
                "LoadedDice": "Ignescent\\LoadedDice\\Laravel\\LoadedDice"
            },
            "providers": [
                "Ignescent\\LoadedDice\\Laravel\\LoadedDiceProvider"
            ]
        }
    },
    "require": {
        "mathieuviossat/fibonacci-heap": "^1.0",
        "php": ">=8.4"
    }
}
